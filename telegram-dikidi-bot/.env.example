# Токен вашего Telegram-бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# mock — тестовый режим со встроенной имитацией DIKIDI (без реального API-ключа);
# live — реальные запросы к DIKIDI Business API.
DIKIDI_MODE=mock

# Нужны только при DIKIDI_MODE=live (см. README.md, раздел "Доступ к DIKIDI API").
DIKIDI_API_BASE_URL=https://api.dikidi.ru/v1
DIKIDI_COMPANY_ID=1539128
DIKIDI_API_KEY=

# Часовой пояс филиала (используется при разборе дат из текста клиента).
DIKIDI_TIMEZONE=Europe/Moscow

# Где хранить SQLite-базу с телефонами клиентов, чтобы не спрашивать контакт каждый раз.
BOT_STORAGE_PATH=./bot_storage.sqlite3
