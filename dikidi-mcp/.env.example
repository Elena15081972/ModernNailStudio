# URL of the DIKIDI Business login page you personally use.
# Open your browser, go to the DIKIDI Business login screen, and copy the exact URL here.
DIKIDI_LOGIN_URL=https://web.dikidi.net/login

# Base URL for the DIKIDI Business panel (usually no need to change).
DIKIDI_BASE_URL=https://web.dikidi.net

# Where the saved browser session (cookies) is stored after the one-time manual login.
# Treat this file like a password: never commit it, never share it.
DIKIDI_STORAGE_STATE_PATH=./.dikidi-session.json

# Run the browser headless (true) once the session is captured, or visibly (false) for debugging.
DIKIDI_HEADLESS=true
