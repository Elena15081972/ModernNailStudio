# Telegram-бот
# Получить у @BotFather командой /newbot
TELEGRAM_TOKEN=

# Твой личный Telegram Chat ID — бот будет отвечать только тебе
# Получить: написать боту @myidbot, либо открыть
# https://api.telegram.org/bot<TELEGRAM_TOKEN>/getUpdates после сообщения боту
TELEGRAM_CHAT_ID=

# Ключ Anthropic API (Claude)
# Создаётся в консоли: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Модель Claude (необязательно, по умолчанию claude-sonnet-5)
ANTHROPIC_MODEL=
